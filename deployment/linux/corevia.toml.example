environment = "production"
data_dir = "/var/lib/corevia"
backup_dir = "/var/backups/corevia"
log_dir = "/var/log/corevia"
host = "127.0.0.1"
port = 8080
threads = 4
# Ejemplos reservados: Sistemas debe sustituirlos por el DNS y las subredes reales.
allowed_hosts = ["corevia.interno.example"]
allowed_networks = ["10.0.0.0/24"]
idle_seconds = 1800
absolute_seconds = 28800
refresh_seconds = 30
